AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_BASE_URL=http://localhost:3001
PORT=3001
# Optional for one local instance; required on Vercel. Use a redis:// or rediss:// endpoint.
REDIS_URL=
